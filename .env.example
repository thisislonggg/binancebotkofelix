# API Key Binance dengan izin C2C / Merchant (wajib)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Token rahasia untuk mengakses dashboard auto-verify (wajib, buat string acak panjang).
# Tanpa ini semua server function DITOLAK.
AUTO_VERIFY_ADMIN_TOKEN=

# Penyimpanan Supabase (wajib di Vercel agar status tersimpan antar-instance).
# Integrasi Supabase di Vercel juga mengisi NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SECRET_KEY: keduanya didukung.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: ganti host API Binance (mis. proxy). Hanya host, tanpa path.
# BINANCE_API_BASE_URL=https://api.binance.com
